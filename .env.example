# Copy to .env.local for local work. On a host, set these as environment variables.
# Never commit real values.

# PostgreSQL address. A hosted database's address ends with ?sslmode=require
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/hotel_admin

# Signs login sessions. Make a new one for every install:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later signs everyone out.
BETTER_AUTH_SECRET=

# The address people type to open the app, with no slash at the end.
BETTER_AUTH_URL=http://localhost:3000

# Required on a hosted install: the code that unlocks the "create the first
# account" page. Pick something long, use it once, then it no longer matters.
SETUP_CODE=

# Optional: how many database connections the app may hold open (default 10).
DB_POOL_MAX=

# Optional: "Sign in with Zoho". Register the app once at https://api-console.zoho.in
# (Server-based Application) and paste the two values here. In Zoho, set the
# Authorized Redirect URI to:  <BETTER_AUTH_URL>/api/auth/callback/zoho
# Leave both empty to use passwords only.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho data centre of your mail account. India is the default.
# Use https://accounts.zoho.com if your Zoho address ends in .com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
